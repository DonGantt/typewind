{
  "name": "typewind-v4",
  "version": "0.1.0",
  "description": "The safety of TypeScript with the magic of Tailwind. Supports Tailwind v4.",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "homepage": "https://github.com/DonGantt/typewind",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "release": "release-it"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DonGantt/typewind.git",
    "directory": "packages/typewind"
  },
  "bin": {
    "typewind": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./cn": {
      "types": "./dist/cn.d.ts",
      "require": "./dist/cn.js",
      "import": "./dist/cn.mjs"
    },
    "./dist/*": "./dist/*",
    "./babel": {
      "types": "./dist/babel.d.ts",
      "default": "./dist/babel.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./transform": {
      "types": "./dist/transform.d.ts",
      "default": "./dist/transform.js"
    }
  },
  "keywords": [
    "typescript",
    "tailwind",
    "tailwindcss",
    "tailwind-v4",
    "babel-plugin",
    "zero-runtime"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@babel/core": "^7.25.0",
    "@babel/generator": "^7.25.0",
    "@babel/plugin-syntax-jsx": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "clsx": "^2.1.1",
    "eval": "^0.1.8",
    "lightningcss": "^1.27.0",
    "tailwind-merge": "^2.5.0",
    "tsup": "^8.3.0"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.0",
    "release-it": "^17.8.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  }
}
