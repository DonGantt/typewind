{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  dependencyDashboard: true,
  extends: [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
  ],
  prConcurrentLimit: 10,
  prHourlyLimit: 5,
  osvVulnerabilityAlerts: true,
  rangeStrategy: "auto",
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 4am on monday"],
  },
  packageRules: [
    {
      description: "Group lockfile updates by manager",
      matchUpdateTypes: ["lockFileMaintenance"],
      groupName: "{{manager}} lockfile updates",
      commitMessageSuffix: "for {{manager}}",
    },
    {
      matchDepTypes: ["action"],
      pinDigests: true,
    },
    {
      description: "Automerge patch updates for devDependencies",
      matchDepTypes: ["devDependencies"],
      matchUpdateTypes: ["patch"],
      automerge: true,
    },
    {
      description: "Flag major updates for manual review",
      matchUpdateTypes: ["major"],
      labels: ["major-update"],
      assignees: ["DonGantt"],
      automerge: false,
    },
  ],
  vulnerabilityAlerts: {
    commitMessageSuffix: "",
    labels: ["security"],
  },
}
